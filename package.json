  "bugs": {
    "url": "https://github.com/x0xll/sarabella.neocities.org/issues"
  },
  "homepage": "https://github.com/x0xll/sarabella.neocities.org#readme",
  "devDependencies": {
    "jest": "^30.2.0"
  }
}
