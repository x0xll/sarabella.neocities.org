        <trigger>
          <object type="questData.EnterZoneTrigger">
            <zoneName>Z009</zoneName>
          </object>
        </trigger>
        <conditions />
        <actions>
          <object type="questData.DialogueAction">
            <text>Gaelic's Bric-a-brac, Furniture and Gifts is finally open! Find this shop at the west end of Artisans Way. </text>
          </object>
        </actions>
      </line>
      <line description="Complete">
