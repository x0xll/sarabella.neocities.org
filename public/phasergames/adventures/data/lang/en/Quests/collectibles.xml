            <template>I012Template</template>
            <count>10</count>
          </object>
        </actions>
      </line>
      <line description="Complete">
        <trigger>
          <object type="questData.RemoveEntityTrigger">
            <template>SpiderSilkTemplate</template>
          </object>
        </trigger>
        <conditions>
          <object type="questData.HasMultipleItemsCondition">
            <template>I012Template</template>
            <count>9</count>
          </object>
        </conditions>
        <actions>
          <object type="questData.LogQuestEndAction" />
          <object type="questData.MonologueAction">
            <text>Hannah loves experimenting with different fabrics. I bet she’d love this spider silk. I should bring it to her. </text>
          </object>
          <object type="questData.AddQuestAction">
            <questId>QUE-0000002811</questId>
          </object>
          <object type="questData.RemoveQuestAction" />
        </actions>
      </line>
      <line description="Reminder (Hannah)">
        <trigger>
          <object type="questData.TalkQuestTrigger">
            <identifier>C018</identifier>
            <isPrimary>false</isPrimary>
          </object>
        </trigger>
        <conditions />
        <actions>
          <object type="questData.DialogueAction">
            <text>I love trying to weave with new materials. I would like to give spider silk a try, but Darkcomb Forest really scares me!</text>
          </object>
          <object type="questData.DialogueAction">
            <text>If you were brave enough to find me 10 spider silks, I would be very grateful. And I’d pay you too!</text>
          </object>
