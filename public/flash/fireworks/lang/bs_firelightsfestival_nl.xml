	<help>
		<instruct>
			<text _x="0" _y="20" _width="450" selectable="0"><![CDATA[<p class="help_instruct_1">Een spannend spel dat eindigt met &#13;JOUW indrukwekkende vuurwerkshow!</p>]]></text>
			<text _x="25" _y="75" _width="400" selectable="0"><![CDATA[<p class="help_instruct_1">Spelregels:&#13;Klik op de molentjes om het vuurwerk bloot te leggen en zo veel mogelijk vuurwerk te verzamelen. Hoe meer je verzamelt, hoe groter je show! Zodra de zon ondergaat is de tijd op en gaat de show van start.&#13;Succes!</p>]]></text>
		</instruct>
		<tip>
			<text _x="14" _y="25" _width="240" selectable="0"><![CDATA[<p class="help_tip_1">De teller laat zien hoeveel vuurwerk er in elke buis zit</p>]]></text>
		</tip>
		<tip>
			<text _x="14" _y="25" _width="240" selectable="0"><![CDATA[<p class="help_tip_1">Klik op het vuurwerk of gebruik de spatiebalk om ze aan je show toe te voegen</p>]]></text>
		</tip>	
		<tip>
			<text _x="14" _y="25" _width="240" selectable="0"><![CDATA[<p class="help_tip_1">De molentjes zullen uit het scherm vliegen</p>]]></text>
		</tip>	
		<tip>
			<text _x="14" _y="25" _width="240" selectable="0"><![CDATA[<p class="help_tip_1">Je kan alleen vuurwerk verzamelen waar geen andere tegels meer op liggen</p>]]></text>
		</tip>	
		<tip>
			<text _x="14" _y="25" _width="240" selectable="0"><![CDATA[<p class="help_tip_1">Zodra de zon ondergaat begint de vuurwerkshow!</p>]]></text>
		</tip>
		<begin_btn>
			<label _x="-60" _y="-15" _width="125" selectable="0"><![CDATA[<p class="begin_btn_1">Begin</p>]]></label>
		</begin_btn>		
